# The website form sends email through AWS SES (ap-southeast-2) using Vercel
# OIDC. There are no AWS keys anywhere - Vercel swaps its own short-lived token
# for temporary credentials on this IAM role.
#
# Set in the Vercel project (Production and Preview), with OIDC Federation on
# (Team mode). Not needed for `pnpm dev` unless you want real sends locally.
AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/billie-prod-website-mailer
